.env
__pycache__/
*.pyc
.venv/

# スクショ画像
# 【2026-10-06 変更】以前は容量を理由に全部除外していたが、
# そのせいで koara / yukipi のスクショが1枚も残っておらず、元画像を見返せない。
# 参考アカウントの分析は元画像に戻れることが前提なので、追跡する。
# (76枚で約15MB。gitで扱える範囲)
!analysis/accounts/*/screenshots/*

# 受け渡し用にまとめたzip。中身は全部リポジトリに入っているので追跡しない
*.zip

# バックアップ(*.bak_YYYY-MM-DD)。手元に残すが追跡しない
# 【2026-10-09 追加】修正前バックアップが未追跡で残り、毎回警告が出ていた
*.bak_*
