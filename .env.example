# Claude(Anthropic)のAPIキー。https://console.anthropic.com/ で発行できます
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# あなたのObsidian Vault(ノートが保存されているフォルダ)の場所
# 例(Mac): /Users/あなたの名前/Documents/ObsidianVault
# 例(Windows): C:\Users\あなたの名前\Documents\ObsidianVault
OBSIDIAN_VAULT_PATH=/path/to/your/ObsidianVault

# Vaultの中で、投稿ネタのメモを置いているフォルダ名(サブフォルダ)
INPUT_FOLDER=投稿ネタ

# Vaultの中で、生成された投稿文を書き出すフォルダ名(サブフォルダ、無ければ自動作成)
OUTPUT_FOLDER=生成済み投稿
